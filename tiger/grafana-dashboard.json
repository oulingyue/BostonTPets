{
  "__inputs": [
    {
      "name": "DS_TIGER",
      "label": "Tiger",
      "description": "PostgreSQL data source for your Tiger service",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "title": "BostonTPets on Tiger Data",
  "uid": "bostontpets-tiger",
  "timezone": "America/New_York",
  "refresh": "10s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 39,
  "tags": [
    "bostontpets",
    "tiger"
  ],
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "source",
        "type": "custom",
        "query": "live,simulated",
        "multi": true,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": [
            "live",
            "simulated"
          ],
          "value": [
            "live",
            "simulated"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "live",
            "value": "live"
          },
          {
            "selected": true,
            "text": "simulated",
            "value": "simulated"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**BostonTPets on Tiger Data.** Every pet pull scanned at a T station, copied from Supabase every minute. Use the **source** filter: `live` is real players; `simulated` is a generated week of commute-shaped traffic that fills the charts. Demo booth accounts are left out of the drop-rate check."
      }
    },
    {
      "id": 2,
      "title": "Scans per hour by line",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, line AS metric, sum(scans) AS scans\nFROM station_traffic_hourly\nWHERE $__timeFilter(bucket) AND source IN ($source)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "red"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#DA291C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "orange"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ED8B00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "green"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00843D"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blue"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#003DA5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "silver"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#7C878E"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "Columnstore savings",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT before_compression_total_bytes AS \"Before\",\n       after_compression_total_bytes AS \"After\",\n       round(before_compression_total_bytes::numeric / nullif(after_compression_total_bytes, 0), 1) AS \"Smaller by\"\nFROM hypertable_columnstore_stats('scans')"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Smaller by"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix:×"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "Busiest stations",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT station_name, line, sum(scans) AS scans\nFROM station_traffic_hourly\nWHERE $__timeFilter(bucket) AND source IN ($source)\nGROUP BY 1, 2\nORDER BY scans DESC\nLIMIT 10"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "station_name",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 5,
      "title": "Rush-hour profile, average scans per hour of day in Boston",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT lpad(extract(hour FROM bucket AT TIME ZONE 'America/New_York')::int::text, 2, '0') || ':00' AS hour,\n       round(avg(scans) FILTER (WHERE extract(isodow FROM bucket AT TIME ZONE 'America/New_York') <= 5), 1) AS weekday,\n       round(avg(scans) FILTER (WHERE extract(isodow FROM bucket AT TIME ZONE 'America/New_York') > 5), 1) AS weekend\nFROM (\n  SELECT bucket, sum(scans) AS scans\n  FROM station_traffic_hourly\n  WHERE $__timeFilter(bucket) AND source IN ($source)\n  GROUP BY bucket\n) hourly\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {
        "xField": "hour",
        "showValue": "never",
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Drop-rate check",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT source, line, rarity, pulls, observed_share, expected_share, z_score\nFROM odds_check\nWHERE source IN ($source)"
        }
      ],
      "description": "Observed share of each rarity per line vs the catalog odds. z_score = (observed - expected) / standard error. |z| under 3 is ordinary randomness; with 20 cells, one near ±3 now and then is expected by chance. Blank until a line has enough pulls.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "z_score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": -3
                    },
                    {
                      "color": "red",
                      "value": 3
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "observed_share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expected_share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "Live scan feed, newest real scans",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT created_at AS time, station_name, line, pet_id, rarity, is_gold\nFROM scans\nWHERE source = 'live' AND NOT is_demo\nORDER BY created_at DESC\nLIMIT 10"
        }
      ]
    },
    {
      "id": 8,
      "title": "Riders per day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_TIGER}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_TIGER}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time_bucket(INTERVAL '1 day', created_at, 'America/New_York') AS time,\n       count(DISTINCT user_id) AS riders\nFROM scans\nWHERE $__timeFilter(created_at) AND source IN ($source)\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        }
      }
    }
  ]
}
